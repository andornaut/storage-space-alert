#!/bin/bash

set -e -o pipefail

NAME="$(basename "$0")"

[[ "$#" -le 2 ]] \
    || { echo "Usage: ${NAME} [alertPercentage] [email]" >&2; exit 1; }

alertPercentage=${1-98}
email=${2}

checkStorageUsage() {
    while read -r filesystem size used free usedPercentage mnt ; do
        if [[ "${usedPercentage%\%}" -ge "${alertPercentage}" ]]; then
            message+="\n---\nFilesystem: ${filesystem}\n"
            message+="Mount: ${mnt}\n"
            message+="Used: ${used} (${usedPercentage})\n"
            message+="Free: ${free}"
        fi
    done

    if [[ -n "${message}" ]]; then
        host=$(hostname --fqdn)
        message="${NAME}\n\nHost: ${host}\nDate: $(date)\nAlert Percentage: ${alertPercentage}%${message}"
        echo -e "${message}"
        if [[ -n "${email}" ]]; then
            echo -e "${message}" | mail -s "${NAME} triggered on ${host}" "${email}"
        fi
    fi
}

# Exclude pseudo/virtual filesystems by type so only real storage is checked.
df -HP -x tmpfs -x devtmpfs -x efivarfs -x squashfs -x overlay -x iso9660 2>/dev/null \
    | grep -v '^Filesystem' \
    | checkStorageUsage
